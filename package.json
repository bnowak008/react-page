{
  "private": true,
  "author": "ORY GmbH",
  "name": "react-page",
  "license": "MIT",
  "workspaces": [
    "packages/editor",
    "packages/plugins/content/*",
    "packages/plugins/layout/*",
    "packages/react-admin",
    "examples/*"
  ],
  "devDependencies": {
    "@emotion/react": "11.11.0",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "5.15.11",
    "@mui/material": "5.15.11",
    "@testing-library/jest-dom": "6.4.0",
    "@testing-library/react": "14.0.0",
    "@types/bun": "latest",
    "@types/invariant": "^2.2.37",
    "@types/react": "18.2.0",
    "@types/react-color": "3.0.12",
    "@types/react-dom": "18.2.0",
    "@types/react-redux": "7.1.34",
    "@biomejs/biome": "1.5.3",
    "color-parse": "2.0.0",
    "entities": "^6.0.0",
    "happy-dom": "13.3.8",
    "react": "18.2.0",
    "react-color": "2.19.3",
    "react-dom": "18.2.0",
    "react-lazy-with-preload": "2.2.1",
    "react-use": "17.5.0",
    "redux": "5.0.1",
    "typescript": "5.3.3",
    "uniforms": "4.0.0",
    "uniforms-bridge-json-schema": "4.0.0",
    "uniforms-mui": "4.0.0",
    "zustand": "4.5.1"
  },
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "build": "bun run clean && bun run build:packages",
    "build:packages": "bun run build:editor && bun run build:plugins && bun run build:admin",
    "build:editor": "cd packages/editor && bun build ./src/index.tsx --outdir ./lib --target browser --external react --external react-dom --external @mui/material --external @emotion/react --external @emotion/styled",
    "build:plugins": "for dir in packages/plugins/content/*/src/index.ts packages/plugins/layout/*/src/index.ts; do if [ -f \"$dir\" ]; then plugin_dir=$(dirname $(dirname $dir)); bun build $dir --outdir $plugin_dir/lib --target browser --external react --external react-dom --external @mui/material --external @emotion/react --external @emotion/styled --external @react-page/editor; fi; done",
    "build:admin": "cd packages/react-admin && bun build ./src/index.tsx --outdir ./lib --target browser --external react --external react-dom --external @mui/material --external @emotion/react --external @emotion/styled --external @react-page/editor",
    "build:watch": "bun run build:editor --watch",
    "test": "bun test --preload ./test/setup.ts",
    "test:watch": "bun test --watch --preload ./test/setup.ts",
    "test:coverage": "bun test --coverage --preload ./test/setup.ts",
    "benchmark": "bun test test/performance/benchmark.ts --timing",
    "benchmark:watch": "bun test test/performance/benchmark.ts --timing --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "lint:fix-unsafe": "biome check --apply-unsafe .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "clean": "rm -rf ./packages/*/lib ./packages/*/lib-es ./packages/plugins/**/lib ./dist",
    "docs": "bun run docs/serve.ts",
    "security": "bun run scripts/security-scan.ts",
    "security:fix": "bun pm audit --fix",
    "deps:check": "bun pm outdated",
    "deps:update": "bun pm upgrade",
    "cleanup": "bun scripts/cleanup.ts",
    "cleanup:dry-run": "bun scripts/cleanup.ts --dry-run"
  },
  "module": "index.ts",
  "type": "module",
  "packageManager": "bun@1.0.0",
  "engines": {
    "bun": ">=1.0.0"
  },
  "resolutions": {
    "semver": ">=7.5.2",
    "word-wrap": ">=1.2.4"
  }
}