{
  "name": "@react-page/editor",
  "version": "0.0.0",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib-es/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "bun build ./src/index.tsx --outdir ./lib --target node",
    "build:esm": "bun build ./src/index.tsx --outdir ./lib-es --target browser",
    "build:watch": "bun build ./src/index.tsx --outdir ./lib --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf lib lib-es *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mui/material": "^5.15.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0"
  },
  "dependencies": {
    "@mui/icons-material": "^5.15.0",
    "classnames": "^2.3.1",
    "react-dnd": "^16.0.0",
    "react-dnd-html5-backend": "^16.0.0",
    "react-redux": "^8.1.0",
    "redux": "^5.0.0",
    "redux-thunk": "^2.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@testing-library/react": "^14.0.0",
    "typescript": "^5.3.0"
  }
}
